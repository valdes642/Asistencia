<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context=".AdminReportsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingBottom="12dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAdmin"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:logo="@drawable/ic_logo_toolbar"
            app:logoDescription="@string/logo_description"
            app:title="Panel Administrador"
            app:titleTextAppearance="@style/Asistencia.Text.Toolbar"
            app:titleTextColor="@color/on_hero" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_sheet"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarAdmin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Resumen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Asistencia.Card"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Asistencia.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Asistencias Hoy"
                            android:textSize="13sp" />

                        <TextView
                            style="@style/Asistencia.Text.Metric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="22 / 25"
                            android:textColor="@color/success_fg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Asistencia.Card"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Asistencia.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Atrasos / Inasist."
                            android:textSize="13sp" />

                        <TextView
                            style="@style/Asistencia.Text.Metric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="3"
                            android:textColor="@color/danger_fg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Buscador Administrador por Nombre, Email, Estado, RUT y Fecha -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Asistencia.Card"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Asistencia.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buscador Administrador" />

                    <!-- Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="16dp"
                        android:hint="Nombre del Trabajador"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="12dp"
                        android:hint="Email del Trabajador"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Estado -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="12dp"
                        android:hint="Estado (ej. A tiempo, Atraso, Ausente)"
                        app:startIconDrawable="@drawable/ic_clock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- RUT -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="12dp"
                        android:hint="RUT del Trabajador (opcional)"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminRut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Fecha -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="12dp"
                        android:hint="Fecha (ej. DD/MM/AAAA)"
                        app:startIconDrawable="@drawable/ic_calendar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="date" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminQuery"
                        style="@style/Asistencia.Button.Outlined"
                        android:layout_marginTop="16dp"
                        android:text="Buscar Trabajador"
                        app:icon="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/tvAdminQueryResult"
                        style="@style/Asistencia.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Resultado: Ingrese Nombre, Email o Estado para buscar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Asistencia.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Control de Personal por Estado" />

            <!-- Trabajador 1 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Asistencia.Card"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        style="@style/Asistencia.Avatar"
                        android:text="VV" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Asistencia.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Victor Vergara"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/Asistencia.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18.987.654-3 · Entrada: 08:00 hrs"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/Asistencia.Chip.Success"
                        android:text="A tiempo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trabajador 2 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Asistencia.Card"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        style="@style/Asistencia.Avatar"
                        android:text="RT" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Asistencia.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ricardo Tapia"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/Asistencia.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15.123.456-7 · Entrada: 08:45 hrs"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/Asistencia.Chip.Warning"
                        android:text="Atraso" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trabajador 3 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Asistencia.Card"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        style="@style/Asistencia.Avatar"
                        android:text="TM" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Asistencia.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tomas Monjes"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/Asistencia.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="19.876.543-2 · Sin registro"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/Asistencia.Chip.Danger"
                        android:text="Ausente" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cerrar Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Asistencia.Button.Outlined"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="Cerrar Sesión"
                app:strokeColor="@color/danger_fg" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
