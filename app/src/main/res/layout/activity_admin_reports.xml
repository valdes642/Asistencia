<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context=".AdminReportsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingBottom="12dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAdmin"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:logo="@drawable/ic_logo_toolbar"
            app:logoDescription="@string/logo_description"
            app:title="Panel Administrador"
            app:titleTextAppearance="@style/Asistencia.Text.Toolbar"
            app:titleTextColor="@color/on_hero" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_sheet"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarAdmin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Formulario Añadir Usuario -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Asistencia.Card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Asistencia.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Añadir Usuario"
                        android:textSize="18sp" />

                    <!-- Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="14dp"
                        android:hint="Nombre"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewUserName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="12dp"
                        android:hint="Email"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewUserEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="12dp"
                        android:hint="Contraseña"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewUserPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Guardar Usuario -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddUser"
                        style="@style/Asistencia.Button"
                        android:layout_marginTop="16dp"
                        android:text="Guardar Usuario" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filtros: Todos / Activos / Inactivos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterAll"
                    style="@style/Asistencia.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Todos"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterActive"
                    style="@style/Asistencia.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:text="Activos"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterInactive"
                    style="@style/Asistencia.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Inactivos"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Encabezado Tabla Usuarios: Nombre | Email | Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_sheet"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    style="@style/Asistencia.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Nombre"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Asistencia.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:text="Email"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Asistencia.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:gravity="end"
                    android:text="Estado"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Contenedor Dinámico de Lista de Usuarios -->
            <LinearLayout
                android:id="@+id/layoutWorkersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Cerrar Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Asistencia.Button.Outlined"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:text="Cerrar Sesión"
                app:strokeColor="@color/danger_fg" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
