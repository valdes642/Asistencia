<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context=".DashboardActivity">

    <!-- Cabecera -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:logo="@drawable/ic_logo_toolbar"
            app:logoDescription="@string/logo_description"
            app:title="Portal del Trabajador"
            app:titleTextAppearance="@style/Asistencia.Text.Toolbar"
            app:titleTextColor="@color/on_hero" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvUserGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Hola, Camila Rojas"
                android:textColor="@color/on_hero"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvUserRut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="camila.rojas@empresa.cl"
                android:textColor="@color/on_hero_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_sheet"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Estado de Marcas (Paso 6: Entrada Reflejada | Paso 9: Salida Reflejada) -->
            <com.google.android.material.card.MaterialCardView style="@style/Asistencia.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Asistencia.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado de Asistencia en Tiempo Real"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvLiveStatus"
                        style="@style/Asistencia.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Esperando sincronización con el servidor..."
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <!-- Botón para Refrescar/Sincronizar (Paso 6 y 9) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshLive"
                        style="@style/Asistencia.Button"
                        android:layout_marginTop="16dp"
                        android:text="Actualizar Marcas (Sincronizar)"
                        app:icon="@drawable/ic_clock" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Registro Manual si se requiere -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Asistencia.Card"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:hint="Email del usuario"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUserEmailInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegisterCheckIn"
                            style="@style/Asistencia.Button"
                            android:layout_width="0dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Registrar Entrada" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegisterCheckOut"
                            style="@style/Asistencia.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Registrar Salida" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección Historial Reciente -->
            <TextView
                style="@style/Asistencia.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Historial reciente"
                android:textSize="18sp" />

            <!-- Encabezado Tabla Historial: Usuario | Email | Tipo | Hora -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sheet"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    style="@style/Asistencia.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:text="Usuario"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Asistencia.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:text="Email"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Asistencia.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Tipo"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Asistencia.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:gravity="end"
                    android:text="Hora"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Contenedor Dinámico del Historial -->
            <LinearLayout
                android:id="@+id/layoutHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Solo visible para administradores -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAdmin"
                style="@style/Asistencia.Button.Tonal"
                android:layout_marginTop="20dp"
                android:text="Ir a Panel Administrador"
                android:visibility="gone"
                app:icon="@drawable/ic_shield" />

            <!-- Cerrar Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Asistencia.Button.Outlined"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="Cerrar Sesión"
                app:strokeColor="@color/danger_fg" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
