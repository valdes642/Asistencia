<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context=".DashboardActivity">

    <!-- Cabecera -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:logo="@drawable/ic_logo_toolbar"
            app:logoDescription="@string/logo_description"
            app:title="Portal del Trabajador"
            app:titleTextAppearance="@style/Asistencia.Text.Toolbar"
            app:titleTextColor="@color/on_hero" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvUserGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Hola, Victor Vergara"
                android:textColor="@color/on_hero"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvUserRut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="RUT: 18.987.654-3"
                android:textColor="@color/on_hero_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_sheet"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Marcar entrada y salida -->
            <com.google.android.material.card.MaterialCardView style="@style/Asistencia.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvClockStatus"
                        style="@style/Asistencia.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Estado: No has marcado entrada hoy" />

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:text="08:30:00"
                        android:textColor="@color/text_primary"
                        android:textSize="44sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClockAction"
                        style="@style/Asistencia.Button"
                        android:layout_marginTop="20dp"
                        android:text="Marcar Entrada"
                        app:icon="@drawable/ic_clock" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GU-05: Consultar Asistencia por Fecha (Trabajador) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Asistencia.Card"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Asistencia.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultar Asistencia por Fecha" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Asistencia.TextField"
                        android:layout_marginTop="16dp"
                        android:hint="Fecha (ej. DD/MM/AAAA)"
                        app:startIconDrawable="@drawable/ic_calendar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etQueryDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="date" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQueryAttendance"
                        style="@style/Asistencia.Button.Outlined"
                        android:layout_marginTop="12dp"
                        android:text="Buscar Registro"
                        app:icon="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/tvQueryResult"
                        style="@style/Asistencia.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Resultado: Seleccione una fecha para consultar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Solo visible para administradores -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAdmin"
                style="@style/Asistencia.Button.Tonal"
                android:layout_marginTop="16dp"
                android:text="Ir a Panel Administrador"
                android:visibility="gone"
                app:icon="@drawable/ic_shield" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
